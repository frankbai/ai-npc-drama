# 环境变量示例。复制成 .env 再填（.env 不会被提交）。
# 程序不会自动读这个文件，用法二选一：
#   docker run --env-file .env -p 8800:8800 ai-npc-drama
#   set -a; source .env; set +a; python3 run.py
# 每一项的含义见 docs/配置说明.md。不填密钥就是模拟模式。

# ---- 模型 ----
OPENAI_API_KEY=
NPC_BASE_URL=https://api.openai.com/v1
NPC_MODEL=
# NPC_FAST_MODEL=
# NPC_REASONING_EFFORT=low      # 模型服务不认这个参数就填 none
# NPC_MAX_TOKENS_PARAM=max_completion_tokens
# NPC_JSON_MODE=1
# NPC_STREAM_USAGE=1

# ---- 放到网上给别人玩时才需要 ----
# ACCESS_CODE=                  # 体验口令，设置了就进入线上模式
# ADMIN_CODE=                   # 管理员口令，必须和体验口令不同
# SESSION_SECRET=               # 随便一串长随机字符
# SHOW_MIND=0
# TURNS_PER_MINUTE=10
# TURNS_PER_DAY=300

# ---- 存储与内容 ----
# DATABASE_URL=postgresql://user:pass@host:5432/db   # 不填就用 SQLite，数据在 DATA_DIR
# DATA_DIR=local-data
# CONTENT_DIR=content
